# ==============================================================================
# Enterprise Workflow Platform - Environment Configuration
# Copy this file to '.env' in this directory (or in the 'docker/' directory).
# '.env' is automatically ignored by git and will not be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) Credentials
# ------------------------------------------------------------------------------
# 1. Sign in to https://portal.azure.com or https://entra.microsoft.com
# 2. Go to "App registrations" -> "New registration"
# 3. Add Redirect URI (Web): http://localhost/login/oauth2/code/azure
# 4. Copy Application (client) ID and Directory (tenant) ID from the Overview tab
AZURE_CLIENT_ID=your-azure-application-client-id-here
AZURE_TENANT_ID=your-azure-directory-tenant-id-here

# 5. Go to "Certificates & secrets" -> "New client secret" -> Copy Value
AZURE_CLIENT_SECRET=your-azure-client-secret-value-here

# ------------------------------------------------------------------------------
# Keycloak SSO (Default Local Configuration)
# ------------------------------------------------------------------------------
OAUTH2_CLIENT_ID=ewp-gateway
OAUTH2_CLIENT_SECRET=ewp-client-secret-2026
