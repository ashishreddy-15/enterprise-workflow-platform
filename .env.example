# ==============================================================================
# Enterprise Workflow Platform - Environment Configuration Template
# Copy this file to '.env' at project root and into 'docker/.env'.
# '.env' is automatically ignored by git and will not be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration & Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=ewp_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=workflow_db

# ------------------------------------------------------------------------------
# MongoDB Configuration & Credentials
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=ewp_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password
MONGO_TEMPLATE_DB=template_db
MONGO_AUDIT_DB=audit_db

# ------------------------------------------------------------------------------
# Redis Cache Credentials
# ------------------------------------------------------------------------------
REDIS_PASSWORD=your_secure_redis_password

# ------------------------------------------------------------------------------
# Keycloak SSO (Default Local Configuration)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password
OAUTH2_CLIENT_ID=ewp-gateway
OAUTH2_CLIENT_SECRET=ewp-client-secret-2026

# ------------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) Credentials
# ------------------------------------------------------------------------------
# 1. Sign in to https://portal.azure.com or https://entra.microsoft.com
# 2. Go to "App registrations" -> "New registration"
# 3. Add Redirect URI (Web): http://localhost/login/oauth2/code/azure and http://localhost:8080/login/oauth2/code/azure
# 4. Copy Application (client) ID and Directory (tenant) ID from the Overview tab
AZURE_CLIENT_ID=your-azure-application-client-id-here
AZURE_TENANT_ID=your-azure-directory-tenant-id-here

# 5. Go to "Certificates & secrets" -> "New client secret" -> Copy Value
AZURE_CLIENT_SECRET=your-azure-client-secret-value-here

# ------------------------------------------------------------------------------
# Platform Security & JWT Signing Key (HMAC-SHA256, minimum 32 chars / 256 bits)
# Required: The platform will refuse to start if this is missing.
# ------------------------------------------------------------------------------
JWT_SECRET=generate-a-secure-random-256-bit-key-minimum-32-characters

# ------------------------------------------------------------------------------
# JWT Authority / Issuer Identifier (iss claim)
# In production, set to your corporate domain, e.g. https://auth.company.com
# ------------------------------------------------------------------------------
JWT_ISSUER=http://localhost:8080

# ------------------------------------------------------------------------------
# Session Timeouts (Sliding Window)
# ------------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_MAX_LIFESPAN_HOURS=8
SESSION_RENEW_THRESHOLD_MINUTES=15
