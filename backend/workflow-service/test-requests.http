### 1. Create a Blueprint in template-service via Gateway
POST http://localhost:8080/templates/api/v1/templates
Authorization: Bearer architect_admin:ROLE_WORKFLOW_ARCHITECT
Content-Type: application/json

{
  "templateKey": "VENDOR_ONBOARDING_TEST",
  "name": "Enterprise Vendor KYC & Legal Onboarding",
  "description": "Requires requester KYC document upload followed by Legal verification",
  "initialState": "AWAITING_KYC_DOCS",
  "steps": {
    "AWAITING_KYC_DOCS": {
      "stepOrder": 1,
      "stepName": "Upload Vendor KYC Documents",
      "stepType": "DOCUMENT_SUBMISSION",
      "actorScope": "REQUESTER",
      "requiredPayloadKeys": [
        "panCardUrl",
        "gstCertUrl"
      ],
      "isTerminal": false,
      "transitions": {
        "SUBMIT_DOCS": "PENDING_LEGAL_VERIFY",
        "CANCEL": "CANCELLED"
      }
    },
    "PENDING_LEGAL_VERIFY": {
      "stepOrder": 2,
      "stepName": "Legal Counsel Compliance Review",
      "stepType": "APPROVAL",
      "actorScope": "ROLE",
      "requiredRole": "ROLE_LEGAL_COUNSEL",
      "requiredPayloadKeys": [],
      "isTerminal": false,
      "transitions": {
        "VERIFY_AND_ONBOARD": "ONBOARDED",
        "REJECT_VENDOR": "REJECTED"
      }
    },
    "ONBOARDED": {
      "stepOrder": 3,
      "stepName": "Vendor Active",
      "stepType": "TERMINAL",
      "actorScope": "ANY",
      "isTerminal": true,
      "transitions": {}
    }
  }
}

### publish
PUT http://localhost:8080/templates/api/v1/templates/VENDOR_ONBOARDING_TEST/versions/1/publish
Authorization: Bearer architect_admin:ROLE_WORKFLOW_ARCHITECT
Content-Type: application/json

